<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="16dp"
    android:layout_marginBottom="16dp"
    android:background="@drawable/post_card_background"
    android:padding="16dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_user_avatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop"
        android:background="@drawable/circular_shape"
        android:clipToOutline="true"
        android:contentDescription="@string/user_avatar_description"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:src="@tools:sample/avatars"
        tools:ignore="UnusedAttribute" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_user_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/iv_user_avatar"
        app:layout_constraintStart_toEndOf="@id/iv_user_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Alice Smith" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_post_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tv_user_name"
        app:layout_constraintStart_toStartOf="@id/tv_user_name"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="20 April at 4:20 PM" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_post_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        app:layout_constraintTop_toBottomOf="@id/iv_user_avatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="We're interested in your ideas and would be glad to build something bigger out of it." />

    <include
        android:id="@+id/layout_post_images"
        layout="@layout/layout_post_images"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tv_post_description"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_comments_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_comment"
        android:contentDescription="@string/comments_icon_description"
        app:layout_constraintTop_toBottomOf="@id/layout_post_images"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_comments_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintTop_toTopOf="@id/iv_comments_icon"
        app:layout_constraintBottom_toBottomOf="@id/iv_comments_icon"
        app:layout_constraintStart_toEndOf="@id/iv_comments_icon"
        tools:text="7 Comments" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_likes_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="24dp"
        android:src="@drawable/ic_like"
        android:contentDescription="@string/likes_icon_description"
        app:layout_constraintTop_toTopOf="@id/iv_comments_icon"
        app:layout_constraintBottom_toBottomOf="@id/iv_comments_icon"
        app:layout_constraintStart_toEndOf="@id/tv_comments_count" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_likes_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintTop_toTopOf="@id/iv_likes_icon"
        app:layout_constraintBottom_toBottomOf="@id/iv_likes_icon"
        app:layout_constraintStart_toEndOf="@id/iv_likes_icon"
        tools:text="49 Likes" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_share_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="24dp"
        android:src="@drawable/ic_share"
        android:contentDescription="@string/share_icon_description"
        app:layout_constraintTop_toTopOf="@id/iv_comments_icon"
        app:layout_constraintBottom_toBottomOf="@id/iv_comments_icon"
        app:layout_constraintStart_toEndOf="@id/tv_likes_count" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_share_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/share"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintTop_toTopOf="@id/iv_share_icon"
        app:layout_constraintBottom_toBottomOf="@id/iv_share_icon"
        app:layout_constraintStart_toEndOf="@id/iv_share_icon" />

    <View
        android:id="@+id/divider_comment"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="#3A3F44"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/iv_comments_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_write_comment"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/divider_comment"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:visibility="visible">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_comment_avatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:scaleType="centerCrop"
            android:background="@drawable/circular_shape"
            android:clipToOutline="true"
            android:contentDescription="@string/user_avatar_description"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:src="@tools:sample/avatars" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_write_comment"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/comment_input_background"
            android:hint="@string/write_comment"
            android:textColorHint="#6B7075"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="textCapSentences"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_comment_avatar"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
