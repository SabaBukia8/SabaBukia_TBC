<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/newLoginFragment">

    <!-- NEW AUTHENTICATION FLOW -->
    <fragment
        android:id="@+id/newLoginFragment"
        android:name="com.example.sababukia_tbc.presentation.screen.login.NewLoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_new_login">
        <action
            android:id="@+id/action_newLoginFragment_to_newRegisterFragment"
            app:destination="@id/newRegisterFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_newLoginFragment_to_newHomeFragment"
            app:destination="@id/newHomeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/newRegisterFragment"
        android:name="com.example.sababukia_tbc.presentation.screen.register.NewRegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_new_register" />

    <fragment
        android:id="@+id/newHomeFragment"
        android:name="com.example.sababukia_tbc.presentation.screen.home.NewHomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_new_home">
        <action
            android:id="@+id/action_newHomeFragment_to_newProfileFragment"
            app:destination="@id/newProfileFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_newHomeFragment_to_usersFragment"
            app:destination="@id/usersFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/newProfileFragment"
        android:name="com.example.sababukia_tbc.presentation.screen.profile.NewProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_new_profile">
        <action
            android:id="@+id/action_newProfileFragment_to_newLoginFragment"
            app:destination="@id/newLoginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/usersFragment"
        android:name="com.example.sababukia_tbc.presentation.screen.users.UsersFragment"
        android:label="Users"
        tools:layout="@layout/fragment_users" />

</navigation>
