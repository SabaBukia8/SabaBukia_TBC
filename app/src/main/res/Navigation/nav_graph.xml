<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/tictactoeConfigFragment">

    <fragment
        android:id="@+id/tictactoeConfigFragment"
        android:name="screen.tictactoe.TicTacToeConfigFragment"
        android:label="TicTacToe Config"
        tools:layout="@layout/fragment_tictactoe_config">
        <action
            android:id="@+id/action_tictactoeConfigFragment_to_tictactoeGameFragment"
            app:destination="@id/tictactoeGameFragment" />
    </fragment>

    <fragment
        android:id="@+id/tictactoeGameFragment"
        android:name="screen.tictactoe.TicTacToeGameFragment"
        android:label="TicTacToe Game"
        tools:layout="@layout/fragment_tictactoe_game">
        <argument
            android:name="boardSize"
            app:argType="integer" />
    </fragment>

</navigation>
