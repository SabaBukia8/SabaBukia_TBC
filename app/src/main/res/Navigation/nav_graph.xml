<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.mtgcollectionmanager.presentation.screen.splash.SplashFragment"
        android:label="@string/app_name">
        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splashFragment_to_collectionsListFragment"
            app:destination="@id/collectionsListFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.mtgcollectionmanager.presentation.screen.auth.login.LoginFragment"
        android:label="@string/login_title">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_collectionsListFragment"
            app:destination="@id/collectionsListFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.mtgcollectionmanager.presentation.screen.auth.register.RegisterFragment"
        android:label="@string/register_title">
        <action
            android:id="@+id/action_registerFragment_to_collectionsListFragment"
            app:destination="@id/collectionsListFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/collectionFragment"
        android:name="com.example.mtgcollectionmanager.presentation.screen.collection.CollectionFragment"
        android:label="@string/collection_title">
        <action
            android:id="@+id/action_collectionFragment_to_cardSearchFragment"
            app:destination="@id/cardSearchFragment" />
        <action
            android:id="@+id/action_collectionFragment_to_cardDetailsFragment"
            app:destination="@id/cardDetailsFragment" />
        <action
            android:id="@+id/action_collectionFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/collectionFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/cardSearchFragment"
        android:name="com.example.mtgcollectionmanager.presentation.screen.search.CardSearchFragment"
        android:label="@string/menu_search">
        <action
            android:id="@+id/action_cardSearchFragment_to_cardDetailsFragment"
            app:destination="@id/cardDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/cardDetailsFragment"
        android:name="com.example.mtgcollectionmanager.presentation.screen.details.CardDetailsFragment"
        android:label="@string/card_details_title">
        <argument
            android:name="cardId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/collectionsListFragment"
        android:name="com.example.mtgcollectionmanager.presentation.screen.collectionslist.CollectionsListFragment"
        android:label="My Collections">
        <action
            android:id="@+id/action_collectionsListFragment_to_collectionFragment"
            app:destination="@id/collectionFragment">
            <argument
                android:name="collectionId"
                app:argType="long"
                android:defaultValue="1L" />
        </action>
        <action
            android:id="@+id/action_collectionsListFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/collectionsListFragment"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>
