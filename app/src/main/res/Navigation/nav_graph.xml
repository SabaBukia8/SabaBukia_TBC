<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/cardListFragment">

    <fragment
        android:id="@+id/cardListFragment"
        android:name="screen.card.CardListFragment"
        android:label="Card Management"
        tools:layout="@layout/fragment_card_list">
        <action
            android:id="@+id/action_cardList_to_addCard"
            app:destination="@id/addCardFragment" />
    </fragment>

    <fragment
        android:id="@+id/addCardFragment"
        android:name="screen.card.AddCardFragment"
        android:label="Add new card"
        tools:layout="@layout/fragment_add_card" />

</navigation>
