<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/userPageFragment">

    <fragment
        android:id="@+id/userPageFragment"
        android:name="com.example.sababukia_tbc.userPage.UserPageFragment"
        android:label="fragment_user_page"
        tools:layout="@layout/fragment_user_page">
        <action
            android:id="@+id/action_userPageFragment_to_addUserFragment"
            app:destination="@id/addUserFragment" />
    </fragment>

    <fragment
        android:id="@+id/addUserFragment"
        android:name="com.example.sababukia_tbc.addUser.AddUserFragment"
        android:label="fragment_add_user"
        tools:layout="@layout/fragment_add_user">
        <argument
            android:name="user"
            app:argType="com.example.sababukia_tbc.userPage.User"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

</navigation>