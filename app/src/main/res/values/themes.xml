<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- =================================================================
         MAIN APP THEME - MTG Dark Gaming Theme
         ================================================================= -->
    <style name="Theme.MTGCollectionManager" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <!-- Secondary Colors -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>

        <!-- Tertiary Colors -->
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorTertiaryContainer">@color/tertiary_container</item>
        <item name="colorOnTertiary">@color/on_tertiary</item>
        <item name="colorOnTertiaryContainer">@color/on_tertiary_container</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high</item>
        <item name="colorOnBackground">@color/on_background</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>

        <!-- Error Colors -->
        <item name="colorError">@color/error</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorOnErrorContainer">@color/on_error_container</item>

        <!-- Outline -->
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>

        <!-- Status Bar & Navigation Bar - Pure Dark -->
        <item name="android:statusBarColor">@color/mtg_black</item>
        <item name="android:navigationBarColor">@color/mtg_dark_surface</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Window Background -->
        <item name="android:windowBackground">@color/mtg_black</item>

        <!-- Typography Styles -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.MTG.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.MTG.DisplayMedium</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.MTG.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.MTG.HeadlineMedium</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.MTG.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.MTG.TitleMedium</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.MTG.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.MTG.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.MTG.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.MTG.LabelLarge</item>

        <!-- Shape Appearances -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.MTG.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.MTG.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.MTG.LargeComponent</item>

        <!-- Component Styles -->
        <item name="materialButtonStyle">@style/Widget.MTG.Button</item>
        <item name="materialCardViewStyle">@style/Widget.MTG.CardView</item>
        <item name="toolbarStyle">@style/Widget.MTG.Toolbar</item>
        <item name="floatingActionButtonStyle">@style/Widget.MTG.FloatingActionButton</item>
        <item name="textInputStyle">@style/Widget.MTG.TextInputLayout</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.MTG.BottomSheetDialog</item>

        <!-- Elevation & Shadows -->
        <item name="elevationOverlayEnabled">true</item>
        <item name="elevationOverlayColor">@color/surface_bright</item>
    </style>

    <!-- =================================================================
         TYPOGRAPHY STYLES - MTG Gaming Aesthetic
         ================================================================= -->

    <!-- Display Styles - Large Headers -->
    <style name="TextAppearance.MTG.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_size_display</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.MTG.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_size_headline_large</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <!-- Headline Styles - Section Headers -->
    <style name="TextAppearance.MTG.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_size_headline</item>
        <item name="android:fontFamily">sans-serif-condensed-medium</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.MTG.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Title Styles - Card Names, Subtitles -->
    <style name="TextAppearance.MTG.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.MTG.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_size_body_large</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Body Styles - Regular Text -->
    <style name="TextAppearance.MTG.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_size_body_large</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.MTG.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.MTG.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">@dimen/text_size_body_small</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Label Styles - Buttons, Small Text -->
    <style name="TextAppearance.MTG.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- =================================================================
         SHAPE APPEARANCES - Rounded Corners
         ================================================================= -->

    <style name="ShapeAppearance.MTG.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_radius_sm</item>
    </style>

    <style name="ShapeAppearance.MTG.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_radius_md</item>
    </style>

    <style name="ShapeAppearance.MTG.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_radius_lg</item>
    </style>

    <!-- =================================================================
         BUTTON STYLES - MTG Themed
         ================================================================= -->

    <!-- Primary Button - Filled with MTG Red -->
    <style name="Widget.MTG.Button" parent="Widget.Material3.Button">
        <item name="android:textAppearance">@style/TextAppearance.MTG.LabelLarge</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="iconTint">@color/on_primary</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">@dimen/button_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/button_padding_horizontal</item>
        <item name="elevation">@dimen/elevation_md</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Outlined Button - Dark with Red Border -->
    <style name="Widget.MTG.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAppearance">@style/TextAppearance.MTG.LabelLarge</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="strokeColor">@color/outline_bright</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="iconTint">@color/primary</item>
        <item name="rippleColor">@color/ripple_accent</item>
    </style>

    <!-- Text Button -->
    <style name="Widget.MTG.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAppearance">@style/TextAppearance.MTG.LabelLarge</item>
        <item name="android:textColor">@color/primary</item>
        <item name="iconTint">@color/primary</item>
        <item name="rippleColor">@color/ripple_accent</item>
    </style>

    <!-- =================================================================
         CARD VIEW STYLES
         ================================================================= -->

    <style name="Widget.MTG.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardElevation">@dimen/elevation_sm</item>
        <item name="cardCornerRadius">@dimen/corner_radius_md</item>
        <item name="strokeColor">@color/outline_variant</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">0dp</item>
    </style>

    <style name="Widget.MTG.CardView.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface_variant</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">@dimen/corner_radius_md</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- =================================================================
         TOOLBAR STYLES
         ================================================================= -->

    <style name="Widget.MTG.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/mtg_dark_surface</item>
        <item name="titleTextAppearance">@style/TextAppearance.MTG.TitleLarge</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="navigationIconTint">@color/primary</item>
        <item name="android:elevation">@dimen/elevation_md</item>
    </style>

    <!-- =================================================================
         FAB STYLES
         ================================================================= -->

    <style name="Widget.MTG.FloatingActionButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/primary</item>
        <item name="tint">@color/on_primary</item>
        <item name="elevation">@dimen/elevation_lg</item>
        <item name="shapeAppearance">@style/ShapeAppearance.MTG.FAB</item>
    </style>

    <style name="ShapeAppearance.MTG.FAB" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- =================================================================
         TEXT INPUT LAYOUT STYLES
         ================================================================= -->

    <style name="Widget.MTG.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="hintTextColor">@color/primary</item>
        <item name="boxStrokeColor">@color/primary</item>
        <item name="boxStrokeErrorColor">@color/error</item>
        <item name="boxBackgroundColor">@color/surface_variant</item>
        <item name="boxCornerRadiusTopStart">@dimen/corner_radius_sm</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_radius_sm</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_radius_sm</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_radius_sm</item>
        <item name="errorTextColor">@color/error</item>
        <item name="counterTextColor">@color/text_tertiary</item>
    </style>

    <!-- =================================================================
         BOTTOM SHEET DIALOG THEME
         ================================================================= -->

    <style name="ThemeOverlay.MTG.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="bottomSheetStyle">@style/Widget.MTG.BottomSheet</item>
    </style>

    <style name="Widget.MTG.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearance">@style/ShapeAppearance.MTG.BottomSheet</item>
        <item name="backgroundTint">@color/surface</item>
    </style>

    <style name="ShapeAppearance.MTG.BottomSheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/bottom_sheet_corner_radius</item>
        <item name="cornerSizeTopRight">@dimen/bottom_sheet_corner_radius</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- =================================================================
         DIALOG THEME
         ================================================================= -->

    <style name="ThemeOverlay.MTG.Dialog" parent="ThemeOverlay.Material3.Dialog">
        <item name="dialogCornerRadius">@dimen/dialog_corner_radius</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="backgroundTint">@color/surface</item>
    </style>
</resources>
